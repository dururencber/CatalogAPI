@model List<CatalogAPI.Web.Models.CatalogItemViewModel>

@{
    ViewData["Title"] = "Ürün Kataloğu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Ürün Kataloğu</h2>
            <p class="text-muted">Clean Architecture API üzerinden anlık çekilen ürünler</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg"></i> + Yeni Ürün Ekle
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info py-4 text-center shadow-sm rounded-4" role="alert">
            <h5 class="alert-heading">Katalogda Henüz Ürün Yok!</h5>
            <p class="mb-0">API'ye ilk ürünü eklemek için yukarıdaki butonu kullanabilirsin.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 transition">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark">@item.Name</h5>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                    Stok: @item.StockQuantity
                                </span>
                            </div>
                            <p class="card-text text-secondary flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="fs-4 fw-bold text-primary">@item.Price.ToString("C2")</span>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu ürünü silmek istediğine emin misin?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Sil
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
